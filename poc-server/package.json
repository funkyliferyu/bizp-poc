{
  "name": "bizp-event-operation-poc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "demo": "tsx src/demo.ts",
    "demo:store-learning": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/demoStoreLearning.ts",
    "db:migrate": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/db/migrate.ts",
    "db:seed": "NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx src/seedStoreLearning.ts",
    "openai:verify": "RUN_OPENAI_INTEGRATION=1 NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run test/openaiLiveIntegration.test.ts",
    "test": "NODE_OPTIONS=--disable-warning=ExperimentalWarning vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^4.77.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
